{
  "name": "privacy-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only synthetic privacy assessment and handoff prototype",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "start:isolated": "node start-isolated.js",
    "start:release": "node start-release.js",
    "start:migration-rehearsal": "node start-migration-rehearsal.js",
    "start:corporate": "node start-corporate.js",
    "test:corporate": "node --test oidc/signin-check.js",
    "storage": "node storage-cli.js",
    "verify:resilience": "node scripts/verify-sqlite-resilience.js",
    "verify:concurrency": "node scripts/verify-sqlite-concurrency-local.js",
    "verify:runtime": "node scripts/runtime-check.js",
    "verify:startup": "node scripts/smoke-local.js",
    "test:browser": "node scripts/run-browser-verification.js",
    "release:local": "node scripts/package-release.js",
    "release:verify": "node scripts/package-release.js --verify-extracted",
    "benchmark:local": "node scripts/benchmark-local.js",
    "build:rust": "node scripts/rust-core.js build",
    "test:rust": "node scripts/rust-core.js test",
    "release:rust": "node scripts/package-release.js --rust",
    "start:rust": "node scripts/rust-core.js start",
    "build:rust-sqlite": "node scripts/rust-native-storage.js build",
    "test:rust-sqlite": "node scripts/rust-native-storage.js test",
    "release:native-rust": "node scripts/package-release.js --native-rust",
    "build:rust-http": "node scripts/rust-native-http.js build",
    "test:rust-http": "node scripts/rust-native-http.js test",
    "verify:native-release": "node scripts/verify-native-release.js",
    "benchmark:rust": "node scripts/benchmark-rust.js"
  }
}

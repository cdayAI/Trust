{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "../scripts/type-tools/node_modules/@types"
    ],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "alwaysStrict": true,
    "rootDir": ".",
    "outDir": "../.typescript-output"
  },
  "include": [
    "**/*.ts"
  ]
}
